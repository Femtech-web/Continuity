CLAWPUMP_API_KEY=
CLAWPUMP_AGENT_ID=
CLAWPUMP_TIMEOUT_MS=7000
PRESTOCKS_API_URL=
PRESTOCKS_API_KEY=
PRESTOCKS_CATALOG_URL=https://prestocks.com/api/prestocks
PRESTOCKS_SPACEX_URL=https://prestocks.com/spacex
PRESTOCKS_TIMEOUT_MS=7000
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_PRO_BASE_URL=https://pyth-lazer.dourolabs.app
PYTH_PRO_API_KEY=
PYTH_SOL_USD_FEED_ID=6
PYTH_PRO_TIMEOUT_MS=7000
METEORA_DBC_CONFIG_ADDRESS=
METEORA_DBC_POOL_ADDRESS=

# CONT launch identity
# Set this to your deployed route, for example:
# https://your-domain.example/token/cont.json
CONT_TOKEN_METADATA_URI=
# Human Solana wallet allowed to approve the locked CONT reference launch.
# This is not the ClawPump agent wallet.
CONT_OPERATOR_WALLET=
CRON_SECRET=

# Optional local Sentinel persistence root. Defaults to .continuity-data/
CONTINUITY_DATA_DIR=

# Supabase (server-only ownership, sessions, drafts, and launch records)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only; prefer SUPABASE_SECRET_KEY for new projects.
SUPABASE_SERVICE_ROLE_KEY=

# Optional execution integrations
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
JUPITER_TIMEOUT_MS=7000
